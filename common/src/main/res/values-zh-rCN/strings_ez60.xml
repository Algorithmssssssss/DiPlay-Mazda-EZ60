<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_mazda_hud">HUD 逐向导航（实验性）</string>
    <string name="settings_mazda_hud_description">CarPlay 导航时，在挡风玻璃抬头显示上显示下一个转弯、距离和道路。在下一次转弯更新时生效。</string>
    <string name="settings_mazda_hud_map_view">HUD 地图视野</string>
    <string name="settings_mazda_hud_map_far">远</string>
    <string name="settings_mazda_hud_map_normal">标准</string>
    <string name="settings_mazda_hud_map_near">近</string>
    <string name="settings_mazda_hud_map_view_description">HUD 显示的地图范围。“远”显示更多街道、更小；“近”显示更少街道、更大。下次连接时生效。</string>
    <string name="settings_mazda_ambient_music">跟随 CarPlay 音乐</string>
    <string name="settings_mazda_ambient_music_description">使用车辆自带的音乐律动模式，让氛围灯随 CarPlay 音乐律动。请先在车上打开氛围灯及其音乐律动。若出现任何故障，DiPlay 会停止并把氛围灯交还给车辆。</string>
    <string name="settings_mazda_ambient_effect">灯光效果</string>
    <string name="settings_mazda_ambient_effect_beat">节拍</string>
    <string name="settings_mazda_ambient_effect_rhythm">律动</string>
    <string name="settings_mazda_ambient_effect_description">“节拍”在每个低音鼓点时点亮氛围灯，并渐暗到下一个鼓点。“律动”随音乐平滑地明暗变化。</string>
    <string name="settings_mazda_ambient_smoothness">平滑度</string>
    <string name="settings_mazda_ambient_depth">深度</string>
    <string name="settings_mazda_ambient_sensitivity">节拍灵敏度</string>
    <string name="settings_mazda_ambient_tuning_description">平滑度：1 变化快，5 变化慢。深度：鼓点之间灯光变暗的程度。节拍灵敏度：5 能捕捉更轻的鼓点。更改立即生效。</string>
    <string name="settings_ez60">马自达 EZ-60</string>
    <string name="settings_ez60_summary">车辆的 HUD 和氛围灯。可在此关闭其中任何一项。</string>
    <string name="settings_mazda_hud_card">挡风玻璃 HUD</string>
    <string name="settings_mazda_trim">EZ-60 车型版本</string>
    <string name="settings_mazda_trim_automatic">自动：%1$s</string>
    <string name="settings_mazda_trim_standard">Option 1 或 2（2D HUD）</string>
    <string name="settings_mazda_trim_ar">Option 3（100 英寸 AR-HUD）</string>
    <string name="settings_mazda_trim_description">DiPlay 按你的车型版本在挡风玻璃上显示：Option 1 和 2 使用 2D HUD 的地图框，Option 3 使用更大的 AR-HUD 地图。“自动”会像车辆自带导航一样从车辆读取版本；仅当“自动”显示的版本不对时再手动选择。在下次连接时生效。</string>
    <string name="settings_gesture_fingers_hint_ez60">在马自达 EZ-60 上，三指滑动会关闭应用，因此 DiPlay 使用两指，不提供三指选项。</string>
    <string name="settings_mazda_ar_map">AR-HUD 地图（实验性）</string>
    <string name="settings_mazda_ar_map_description">在 CarPlay 导航引导中且车辆不在 P 挡时，于 AR-HUD 自带的地图区域显示 CarPlay 地图（没有地图时显示下一个转向）。DiPlay 会为此切换车辆的 HUD 画面，并在路线结束或出现任何故障时交还。车辆自带导航正在引导时请勿使用。开启后在下次连接时生效；关闭后地图会立即移除。</string>
    <string name="settings_mazda_ar_map_size">AR-HUD 地图大小</string>
    <string name="settings_mazda_ar_map_size_car">与车辆一致</string>
    <string name="settings_mazda_ar_map_size_large">大</string>
    <string name="settings_mazda_ar_map_size_largest">最大</string>
    <string name="settings_mazda_ar_map_size_description">默认的“最大”使用 HUD 车速和挡位右侧的 AR-HUD 画面，约为车辆自带地图的三倍；这是在 100 英寸 AR-HUD 车型的挡风玻璃上看起来最清楚的大小。“大”介于两者之间，“与车辆一致”与车辆自带导航的地图相同。地图在左侧时保持车辆的大小。在下次连接时生效。</string>
    <string name="settings_mazda_hud_map_style">HUD 地图样式</string>
    <string name="settings_mazda_hud_map_style_whole">完整地图</string>
    <string name="settings_mazda_hud_map_style_lines">仅线条</string>
    <string name="settings_mazda_hud_map_see_through">背景透明度</string>
    <string name="settings_mazda_hud_map_look_description">HUD 会把地图背景投射成一个发光的方框。透明度越高，背景越淡，越能透过它看到路面：0 % 为 iPhone 绘制的原始地图，100 % 完全去掉背景。“仅线条”还会去掉公园、水域和建筑，并以更高亮度显示道路、路线和地名。更改立即生效。</string>
    <string name="settings_mazda_hud_map_road_boost">道路亮度</string>
    <string name="settings_mazda_hud_map_road_boost_description">把道路、小路、地名和路线提亮到接近最亮，白天也能在挡风玻璃上看清；公园、水域和建筑保持不变。0 % 为原来的地图。更改立即生效。</string>
</resources>
